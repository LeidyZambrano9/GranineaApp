<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nuevo_producto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorverde_letra"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_del_producto"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCrearNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/crear_producto"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp"/>

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/descripcion"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCrearDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/descripcion_producto_admin"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Precio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/precio_producto_admin"
                    android:textColor="@color/white" />

                <EditText
                    android:id="@+id/etCrearPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/precio_total_producto_admin"
                    android:textColor="@color/white"
                    android:textColorHint="#888888"
                    android:backgroundTint="@color/colorverde_letra"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <!-- Tipo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_producto_admin"
                    android:textColor="@color/white" />

                <Spinner
                    android:id="@+id/spinnerTipo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@color/black" />
            </LinearLayout>
        </LinearLayout>


        <!-- Sabores -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sabores_productos_admin"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etCrearSabores"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/hint_sabores_admin"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>
        <!-- ── SECCIÓN IMAGEN ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/imagen_producto"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <!-- Preview de la imagen seleccionada -->
        <ImageView
            android:id="@+id/ivPreviewImagen"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#1A1A1A"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Texto del nombre del archivo -->
        <TextView
            android:id="@+id/tvImagenSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />


        <!-- Botón para abrir galería -->
        <Button
            android:id="@+id/btnSeleccionarImagen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/seleccionar_imagen_text"
            android:backgroundTint="#1A1A1A"
            android:textColor="@color/colorverde_letra"
            android:layout_marginBottom="24dp" />

        <!-- ─────────────────────────────────────────────────────────────── -->

        <ProgressBar
            android:id="@+id/progressBarCrear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/colorverde_letra"/>

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/crear_producto_btn"
            android:textStyle="bold"
            android:backgroundTint="@color/colorverde_letra"
            android:textColor="@color/black"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>