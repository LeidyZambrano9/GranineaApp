<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar Producto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorverde_letra"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Preview imagen -->
        <ImageView
            android:id="@+id/img_producto_editar"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#1A1A1A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvImagenSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_cambiar_imagen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cambiar imagen"
            android:backgroundTint="#1A1A1A"
            android:textColor="@color/colorverde_letra"
            android:layout_marginBottom="24dp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del producto"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_nombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nombre del producto"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_descripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción del producto"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="16dp" />

        <!-- Precio + Tipo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio (COP)"
                    android:textColor="@color/white" />

                <EditText
                    android:id="@+id/et_precio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="0"
                    android:textColor="@color/white"
                    android:textColorHint="#888888"
                    android:backgroundTint="@color/colorverde_letra"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoría"
                    android:textColor="@color/white" />

                <Spinner
                    android:id="@+id/spinner_tipo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@color/black" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sabores -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sabores"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_sabores"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="fresa, mango, uva..."
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Switch activo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Producto activo (visible en catálogo)"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_activo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/colorverde_letra"
                android:trackTint="#444444" />
        </LinearLayout>

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progress_editar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/colorverde_letra" />

        <!-- Guardar -->
        <Button
            android:id="@+id/btn_guardar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Guardar cambios"
            android:textStyle="bold"
            android:backgroundTint="@color/colorverde_letra"
            android:textColor="@color/black"
            android:layout_marginTop="8dp" />

        <!-- Eliminar -->
        <Button
            android:id="@+id/btn_eliminar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Eliminar producto"
            android:textStyle="bold"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FF4444"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>