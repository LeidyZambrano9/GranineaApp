<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editar_producto_admin"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorverde_letra"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_producto_edit_admin"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/etEditarNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/descripcion_producto_admin_edit"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/etEditarDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorverde_letra"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/precio_producto_edit_admin"
                    android:textColor="@color/white" />

                <EditText
                    android:id="@+id/etEditarPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/colorverde_letra"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_producto_edit_admin"
                    android:textColor="@color/white" />

                <Spinner
                    android:id="@+id/spinnerEditarTipo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/white"
                    android:popupBackground="@color/black" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── SECCIÓN IMAGEN ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/imagen_del_producto_edit_admin"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <!-- Preview (imagen actual o nueva) -->
        <ImageView
            android:id="@+id/ivPreviewImagen"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#1A1A1A"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvImagenSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSeleccionarImagen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/cambiar_imagen_edit_admin"
            android:backgroundTint="#1A1A1A"
            android:textColor="@color/colorverde_letra"
            android:layout_marginBottom="24dp" />

        <!-- ─────────────────────────────────────────────────────────────── -->

        <ProgressBar
            android:id="@+id/progressBarEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/colorverde_letra"/>

        <Button
            android:id="@+id/btnGuardarEdicion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/guardar_cambios_edit_admin"
            android:textStyle="bold"
            android:backgroundTint="@color/colorverde_letra"
            android:textColor="@color/black"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>