<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true"
    tools:context=".ui.auth.RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/logo_registro"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo_graninea" />

        <TextView
            android:id="@+id/texto_registrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/island_moments"
            android:text="@string/registrate"
            android:textColor="@color/colorverde_letra"
            android:textSize="35sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/layoutFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <EditText
                android:id="@+id/RegistroNombres"
                android:layout_width="340dp"
                android:layout_height="55dp"
                android:background="@drawable/imagen_campo_formulario"
                android:gravity="center_vertical|start"
                android:hint="@string/nombres"
                android:inputType="textPersonName"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/colornegro_letra"
                android:textColorHint="#808080"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/RegistroApellidos"
                android:layout_width="340dp"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/imagen_campo_formulario"
                android:gravity="center_vertical|start"
                android:hint="@string/apellidos"
                android:inputType="textPersonName"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/colornegro_letra"
                android:textColorHint="#808080"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/RegistroCorreo"
                android:layout_width="340dp"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/imagen_campo_formulario"
                android:hint="@string/placeholder_correo_registro"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center_vertical|start"
                android:textColor="@color/colornegro_letra"
                android:textColorHint="#808080"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/RegistroCelular"
                android:layout_width="340dp"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/imagen_campo_formulario"
                android:hint="@string/placeholder_celular"
                android:inputType="phone"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center_vertical|start"
                android:textColor="@color/colornegro_letra"
                android:textColorHint="#808080"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/RegistroContraseña"
                android:layout_width="340dp"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/imagen_campo_formulario"
                android:hint="@string/placeholder_contra_registro"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center_vertical|start"
                android:textColor="@color/colornegro_letra"
                android:textColorHint="#808080"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/RegistroRepetirContraseña"
                android:layout_width="340dp"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/imagen_campo_formulario"
                android:gravity="center_vertical|start"
                android:hint="@string/repetir_contrase_a"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/colornegro_letra"
                android:textColorHint="#808080"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/CheckTerminos_Registro"
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/tirodevanagarisanskrititalic"
                android:text="Acepto los términos y condiciones"
                android:textColor="@color/colorverde_letra"
                android:textSize="16sp" />

        </LinearLayout>

        <Button
            android:id="@+id/BotonoCrearcuentaRegistro"
            android:layout_width="340dp"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="@color/colorverde_letra"
            android:text="@string/boton_crear_cuenta_registro"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tirodevanagarisanskrititalic"
                android:text="¿Ya tienes cuenta? "
                android:textColor="@color/colorverde_letra"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txt_volver_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tirodevanagarisanskrititalic"
                android:text="Inicia sesión"
                android:textColor="@color/text_white"
                android:clickable="true"
                android:focusable="true"
                android:textSize="18sp" />
        </LinearLayout>


    </LinearLayout>

</ScrollView>