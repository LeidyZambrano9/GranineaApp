<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_fondo">



    <!-- BUSCADOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/buscador"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:hint="@string/hint_busqueda_catalogo"
            android:background="@drawable/bg_search"
            android:padding="10dp"
            android:inputType="text"
            android:imeOptions="actionSearch"/>

        <ImageView
            android:id="@+id/btn_carrito"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_cart"
            android:background="@drawable/bg_search"
            android:padding="10dp"/>

    </LinearLayout>

    <!-- FILTROS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/btn_sin_licor"
            android:text="@string/sin_licor_filter"
            style="@style/FiltroStyle"/>

        <TextView
            android:id="@+id/btn_con_licor"
            android:text="@string/con_licor_filter"
            style="@style/FiltroStyle"/>

        <TextView
            android:id="@+id/btn_xl"
            android:text="@string/xl_filter"
            style="@style/FiltroStyle"/>

    </LinearLayout>

    <!-- PROGRESS BAR — visible mientras carga desde Supabase -->
    <ProgressBar
        android:id="@+id/progressBarCatalogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- LISTA PRODUCTOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_productos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"/>

</LinearLayout>