<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/color_fondo"
android:gravity="center"
android:orientation="vertical"
tools:context="com.app.granineaapp.ui.main.perfil.InformacionPersonalFragment">

<TextView
    android:id="@+id/Perfil_Titulo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/tirodevanagarisanskrititalic"
    android:text="MI PERFIL"
    android:gravity="center"
    android:textColor="@color/colorverde_letra"
    android:textSize="35sp"
    android:layout_marginTop="20dp" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="30dp">

        <!-- Contenedor de foto (Sin el icono de cámara) -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                app:cardCornerRadius="60dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/iv_perfil_foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher_round" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Campos de texto bloqueados -->
        <EditText
            android:id="@+id/et_ver_nombres"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:background="@drawable/imagen_campo_formulario"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical|start"
            android:hint="@string/nombres_informacion_personal"
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/colornegro_letra"
            android:textColorHint="#808080"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_ver_apellidos"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/imagen_campo_formulario"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical|start"
            android:hint="@string/apellidos_informacion_personal"
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/colornegro_letra"
            android:textColorHint="#808080"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_ver_correo"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/imagen_campo_formulario"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical|start"
            android:hint="@string/Correo_informacion_personal"
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/colornegro_letra"
            android:textColorHint="#808080"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_ver_celular"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/imagen_campo_formulario"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical|start"
            android:hint="@string/numero_celular_informacion_personal"
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/colornegro_letra"
            android:textColorHint="#808080"
            android:textSize="14sp" />

        <!-- Botón para IR a la pantalla de edición -->

        <Button
            android:id="@+id/btn_ir_editar_perfil"
            android:layout_width="340dp"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="@color/colorverde_letra"
            android:text="@string/editar_perfil_informacion_personal"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
</LinearLayout>